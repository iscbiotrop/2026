```{=html}
<div class='sponsorsFooter'>
      <h1 id="sponsorTitle" data-default-title="<strong>Speakers</strong>"><strong>Speakers and Trainers</strong></h1>
      <ul class="speakers-grid">
        <% for (const item of items) { %>
            <li>
              <div class="speaker-card">
                <div class="speaker-card__img">
                  <a href="<%- item.href %>" target="_blank">
                    <img src="<%- item.thumbnail %>" alt="<%= item.name %> picture" />
                  </a>
                </div>
                <div class="speaker-card__body">
                  <p><strong><%= item.name %></strong></p>
                  <p><%= item.affiliation %></p>
                  <ul class="speaker-socials">
                    <% if (item.country) { %>
                      <li class="socialIcons">
                        <img src="https://flagcdn.com/24x18/<%= item.country.toLowerCase() %>.png" alt="flag" />
                      </li>
                    <% } %>
                    <% for (const tile of item.social) { %>
                      <% if (tile.website) { %>
                        <li class="socialIcons"><a href="<%- tile.website %>"><i class="bi bi-globe"></i></a></li>
                      <% } %>
                      <% if (tile.github) { %>
                        <li class="socialIcons"><a href="<%- tile.github %>"><i class="bi bi-github"></i></a></li>
                      <% } %>
                      <% if (tile.twitter) { %>
                        <li class="socialIcons"><a href="<%- tile.twitter %>"><i class="bi bi-twitter"></i></a></li>
                      <% } %>
                      <% if (tile.linkedin) { %>
                        <li class="socialIcons"><a href="<%- tile.linkedin %>"><i class="bi bi-linkedin"></i></a></li>
                      <% } %>
                      <% if (tile.facebook) { %>
                        <li class="socialIcons"><a href="<%- tile.facebook %>"><i class="bi bi-facebook"></i></a></li>
                      <% } %>
                      <% if (tile.mastodon) { %>
                        <li class="socialIcons"><a href="<%- tile.mastodon %>"><i class="bi bi-mastodon"></i></a></li>
                      <% } %>
                    <% } %>
                  </ul>
                </div>
              </div>
            </li>
        <% } %>
      </ul>
    </div>
</div>
```
